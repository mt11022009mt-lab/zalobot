# ==============================================================================
# CẤU HÌNH BOT TELEGRAM CHECK TRẠNG THÁI MXH (FB - TIKTOK - INSTAGRAM)
# ==============================================================================

# 1. Telegram Bot Token (Bắt buộc, lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# 2. Giới hạn ID chat được phép dùng bot (Tùy chọn, để trống cho phép mọi người)
# Ví dụ: 123456789,-100123456789
ALLOWED_CHAT_IDS=

# 3. TikTok Research API (Dự án đăng ký TikTok Research API, scope research.data.basic)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# 4. Meta Graph API (Dùng cho Trang Facebook & Instagram Business)
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0

# 5. Instagram (Tùy chọn để vượt Login Wall / Rate limit)
# Cookie sessionid của Instagram khi đăng nhập trên web
INSTAGRAM_SESSION_ID=
# ID tài khoản Instagram Business nếu tra cứu qua Meta Graph API
INSTAGRAM_BUSINESS_ACCOUNT_ID=
